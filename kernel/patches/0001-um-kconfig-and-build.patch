diff -ruN linux-rc4-git/arch/um/Makefile /Users/irul/Kitchen/linux-um-arm64/arch/um/Makefile
--- a/arch/um/Makefile	2026-10-21 20:44:44
+++ b/arch/um/Makefile	2026-10-21 20:22:39
@@ -30,10 +30,6 @@
 	HEADER_ARCH := x86
 endif
 
-ifdef CONFIG_64BIT
-	KBUILD_CFLAGS += -mcmodel=large
-endif
-
 HOST_DIR := arch/$(HEADER_ARCH)
 
 include $(srctree)/$(ARCH_DIR)/Makefile-skas
@@ -66,12 +62,31 @@
 
 KBUILD_AFLAGS += $(ARCH_INCLUDE)
 
+# $(CLANG_FLAGS) carries --target=, which for UML selects the *host* ABI the
+# binary runs on. It normally reaches the compiler through KBUILD_CPPFLAGS, but
+# arch/um/scripts/Makefile.rules replaces c_flags wholesale for USER_OBJS, so
+# KBUILD_CPPFLAGS never gets there and host-side files would be built for the
+# build machine's architecture instead. x86 does not notice: for x86_64 the two
+# are the same, and i386 rides on the -m32 in KBUILD_CFLAGS. An arm64 subarch has
+# no -m flag to ride on, so the triple has to be propagated explicitly.
+# CLANG_FLAGS is empty under gcc, so this is a no-op there.
+# The kernel's own compiler attributes are force-included rather than left to
+# -idirafter below. That flag places $(srctree)/include *after* the system
+# include directories, so <linux/compiler_types.h> resolves to the host
+# sysroot's copy whenever one exists. Debian's does not, so the kernel's is
+# found and everything works; the Android NDK's sysroot ships a 265-byte uapi
+# stub of that name, which then wins and defines none of __section, __used,
+# __aligned, noinline or the sparse annotations. The failures land far from the
+# cause -- "expected parameter declarator" on every __init in UML -- so force
+# the right definitions in instead of discovering them one macro at a time.
 USER_CFLAGS = $(patsubst $(KERNEL_DEFINES),,$(patsubst -I%,,$(KBUILD_CFLAGS))) \
+		$(CLANG_FLAGS) \
 		$(ARCH_INCLUDE) $(MODE_INCLUDE) $(filter -I%,$(CFLAGS)) \
 		-D_FILE_OFFSET_BITS=64 -idirafter $(srctree)/include \
 		-idirafter $(objtree)/include -D__KERNEL__ -D__UM_HOST__ \
 		-include $(srctree)/include/linux/compiler-version.h \
 		-include $(srctree)/include/linux/kconfig.h \
+		-include $(srctree)/include/linux/compiler_attributes.h \
 		-idirafter $(ARCH_DIR)/include/generated
 
 #This will adjust *FLAGS accordingly to the platform.
@@ -141,7 +156,10 @@
 LD_FLAGS_CMDLINE = $(foreach opt,$(KBUILD_LDFLAGS) $(LDFLAGS_EXECSTACK),-Wl,$(opt))
 
 # Used by link-vmlinux.sh which has special support for um link
-export CFLAGS_vmlinux := $(LINK-y) $(LINK_WRAPS) $(LD_FLAGS_CMDLINE) $(CC_FLAGS_LTO)
+# scripts/link-vmlinux.sh links UML with "$(CC) $(CFLAGS_vmlinux)" rather than
+# with $(LD), so the compiler needs the target triple here too -- see the
+# USER_CFLAGS comment above for why KBUILD_CPPFLAGS does not reach this point.
+export CFLAGS_vmlinux := $(filter --target=%,$(CLANG_FLAGS)) $(LINK-y) $(LINK_WRAPS) $(LD_FLAGS_CMDLINE) $(CC_FLAGS_LTO)
 
