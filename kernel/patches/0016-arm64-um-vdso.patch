diff -ruN linux-rc4-git/arch/arm64/um/vdso/vdso.lds.S /Users/irul/Kitchen/linux-um-arm64/arch/arm64/um/vdso/vdso.lds.S
--- a/arch/arm64/um/vdso/vdso.lds.S	1970-01-01 07:00:00
+++ b/arch/arm64/um/vdso/vdso.lds.S	2026-10-21 20:22:38
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Linker script for the UML/arm64 vDSO.
+ *
+ * Deliberately minimal. The only thing UML's guest actually needs from a vDSO
+ * is __kernel_rt_sigreturn (see arch/arm64/um/signal.c); it exports no time
+ * functions, because a UML guest's clock_gettime is a syscall into the UML
+ * kernel, which is a function call, not a trap -- a vDSO fast path would save
+ * nothing and would have to be kept in sync with UML's timekeeping.
+ */
+
+#include <asm/page.h>
+
+OUTPUT_FORMAT("elf64-littleaarch64", "elf64-bigaarch64", "elf64-littleaarch64")
+OUTPUT_ARCH(aarch64)
+
+SECTIONS
+{
+	/*
+	 * The vDSO is mapped as a single page by arch_setup_additional_pages(),
+	 * so everything must fit below PAGE_SIZE. PAGE_SIZE, not 4096: on a
+	 * 16K-page host the guest's page size is 16K too.
+	 */
+	. = SIZEOF_HEADERS;
+
+	.hash		: { *(.hash) }			:text
+	.gnu.hash	: { *(.gnu.hash) }
+	.dynsym		: { *(.dynsym) }
+	.dynstr		: { *(.dynstr) }
+	.gnu.version	: { *(.gnu.version) }
+	.gnu.version_d	: { *(.gnu.version_d) }
+	.gnu.version_r	: { *(.gnu.version_r) }
+
+	.note		: { *(.note.*) }		:text	:note
+
+	.dynamic	: { *(.dynamic) }		:text	:dynamic
+
+	.eh_frame_hdr	: { *(.eh_frame_hdr) }		:text	:eh_frame_hdr
+	.eh_frame	: { KEEP (*(.eh_frame)) }	:text
+
+	.rodata		: { *(.rodata*) }		:text
+
+	.text		: { *(.text*) }			:text	=0xd503201f
+
+	/DISCARD/	: {
+		*(.data .data.* .gnu.linkonce.d.* .sdata*)
+		*(.bss .sbss .dynbss .dynsbss)
+		*(.note.GNU-stack)
+		*(.comment)
+	}
+}
+
+PHDRS
+{
+	text		PT_LOAD		FLAGS(5) FILEHDR PHDRS;	/* PF_R|PF_X */
+	dynamic		PT_DYNAMIC	FLAGS(4);		/* PF_R */
+	note		PT_NOTE		FLAGS(4);		/* PF_R */
+	eh_frame_hdr	PT_GNU_EH_FRAME;
+}
+
+VERSION
+{
+	LINUX_2.6.39 {
+	global:
+		__kernel_rt_sigreturn;
+	local: *;
+	};
+}
diff -ruN linux-rc4-git/arch/arm64/um/vdso/vma.c /Users/irul/Kitchen/linux-um-arm64/arch/arm64/um/vdso/vma.c
--- a/arch/arm64/um/vdso/vma.c	1970-01-01 07:00:00
+++ b/arch/arm64/um/vdso/vma.c	2026-10-21 20:22:38
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Map the UML/arm64 vDSO into every guest process.
+ *
+ * Unlike x86-64 UML, where the vDSO is an optimisation, here it is load-bearing:
+ * aarch64 glibc does not set SA_RESTORER, so returning from a guest signal
+ * handler goes through __kernel_rt_sigreturn in this page. A guest without it
+ * would crash on the first signal.
+ */
+#include <linux/slab.h>
+#include <linux/sched.h>
+#include <linux/mm.h>
+#include <linux/init.h>
+#include <linux/binfmts.h>
+#include <asm/page.h>
+#include <asm/elf.h>
+
+#include "vdso-offsets.h"
+
+unsigned long um_vdso_addr;
+static struct page *um_vdso;
+
+extern unsigned long task_size;
+extern char vdso_start[], vdso_end[];
+
+/*
+ * Where a returning signal handler jumps to. Called from
+ * setup_signal_stack_si() for every guest signal that does not carry
+ * SA_RESTORER, which on aarch64 is essentially all of them.
+ */
+unsigned long um_vdso_sigreturn_addr(void)
+{
+	return um_vdso_addr + um_vdso_offset___kernel_rt_sigreturn;
+}
+
+static int __init init_vdso(void)
+{
+	BUG_ON(vdso_end - vdso_start > PAGE_SIZE);
+
+	/*
+	 * Immediately below the top of the guest address space, matching where
+	 * the real arm64 kernel puts it and where x86 UML puts its own.
+	 */
+	um_vdso_addr = task_size - PAGE_SIZE;
+
+	um_vdso = alloc_page(GFP_KERNEL);
+	if (!um_vdso)
+		panic("Cannot allocate vdso\n");
+
+	copy_page(page_address(um_vdso), vdso_start);
+
+	return 0;
+}
+subsys_initcall(init_vdso);
+
+int arch_setup_additional_pages(struct linux_binprm *bprm, int uses_interp)
+{
+	struct vm_area_struct *vma;
+	struct mm_struct *mm = current->mm;
+	static struct vm_special_mapping vdso_mapping = {
+		.name = "[vdso]",
+		.pages = &um_vdso,
+	};
+
+	if (mmap_write_lock_killable(mm))
+		return -EINTR;
+
+	vma = _install_special_mapping(mm, um_vdso_addr, PAGE_SIZE,
+				       VM_READ | VM_EXEC |
+				       VM_MAYREAD | VM_MAYWRITE | VM_MAYEXEC,
+				       &vdso_mapping);
+
+	mmap_write_unlock(mm);
+
+	return IS_ERR(vma) ? PTR_ERR(vma) : 0;
+}
--- a/arch/arm64/Makefile.um	1970-01-01 07:00:00
+++ b/arch/arm64/Makefile.um	2026-10-21 20:22:38
@@ -0,0 +1,72 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Build glue for ARCH=um SUBARCH=arm64.
+#
+# Included by arch/um/Makefile as $(HOST_DIR)/Makefile.um. Everything here
+# describes the *host* ABI the UML binary is built against, because for UML the
+# "architecture" is an ordinary aarch64 userspace process.
+
+# Link address of the UML kernel binary. Guest processes live in separate host
+# address spaces under SKAS, so this only has to stay clear of the UML kernel's
+# own mappings of guest physical memory, which are placed above the binary.
+# 0x60000000 matches x86_64 UML and leaves the whole 48-bit VA space above it.
+START := 0x60000000
+
+ELF_ARCH	:= aarch64
+ELF_FORMAT	:= elf64-littleaarch64
+
+CHECKFLAGS	+= -D__aarch64__
+
+# Unlike x86 there is nothing to disable here: the aarch64 psABI has no
+# equivalent of x86's "compile the kernel without SSE" problem, because the
+# kernel side never touches the FP/SIMD registers that the guest owns, and
+# -mgeneral-regs-only would break the host-side code that legitimately does.
+
+LINK-$(CONFIG_LD_SCRIPT_DYN_RPATH) += -Wl,-rpath,/lib
+
+# Building against bionic (the Android NDK) collides with the kernel's own
+# definitions of a set of standard-library names. glibc does not show this:
+# its libc.a is finely split, so the objects carrying memcpy, snprintf and the
+# rest are simply never pulled in once the kernel's definitions satisfy every
+# reference. bionic's libc.a is coarser -- the objects that *are* needed also
+# define these -- and the static link then fails with twenty duplicate symbols.
+#
+# Resolving it with --allow-multiple-definition is worse than not building:
+# link order puts the kernel first, so libc's internals end up calling the
+# kernel's memcpy and sem_init, and the binary segfaults before main().
+#
+# The string family is handled in arch/arm64/um/asm/string.h instead, by
+# declaring __HAVE_ARCH_* so lib/string.c does not compile its own -- renaming
+# those fights CONFIG_FORTIFY_SOURCE, which redefines them as macros.
+#
+# The rest are renamed, which is exactly what UML already does for
+# errno, sigprocmask, mktime and strrchr in arch/um/Makefile. These defines
+# reach kernel objects only, never USER_OBJS, so host-side code and libc keep
+# the real names. Compiler-emitted implicit calls (struct copies lowering to
+# memcpy) also keep the real name and get libc's implementation, which is
+# correct and usually faster than the kernel's generic C.
+#
+# The list is not guesswork and not the duplicate-symbol errors either. Those
+# only catch names both sides *define*; the dangerous case is a name libc
+# merely *references* while the kernel defines it, because then there is no
+# error at all -- the reference simply binds to the kernel's function. That is
+# what happened with sched_getaffinity: bionic's startup called it, got the
+# kernel's, and dereferenced a task_struct that does not exist yet. The symptom
+# was a SIGSEGV writing to 0x80 with no output.
+#
+# So the list is the intersection of "undefined in bionic's libc.a" with
+# "defined in vmlinux.a", computed with llvm-nm:
+#
+#   llvm-nm --undefined-only libc.a         | sort -u > A
+#   llvm-nm --defined-only --extern-only vmlinux.a | sort -u > B
+#   comm -12 A B
+#
+# Detected from the compiler rather than configured, because the whole
+# difference is which libc the target triple selects.
+UM_BIONIC := $(shell echo | $(CC) $(CLANG_FLAGS) -dM -E - 2>/dev/null | grep -c __ANDROID__)
+
+ifeq ($(UM_BIONIC),1)
+# Renamed on the object files at link time, not here: see
+# arch/arm64/um/bionic-syms.redef for the list and for why -D is the wrong tool.
+export UM_REDEF_SYMS := $(srctree)/arch/arm64/um/bionic-syms.redef
+endif
